#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');

const command = process.argv[2];

if (command === 'init') {
    console.log('Initializing Luak Express project...');
    initProject();
} else {
    console.log('Usage: luak init');
    process.exit(1);
}

function initProject() {
    const targetDir = process.cwd();
    const packageDir = path.resolve(__dirname, '../'); // Assuming bin is inside the package

    // Directories to copy
    const dirsToCopy = [
        'app',
        'bootstrap',
        'config',
        'routes',
        // 'database' // Optional, maybe created empty
    ];

    // Files to copy
    const filesToCopy = [
        'index.js',
        '.env.example',
        'gitignore.example' // We might need to rename .gitignore check
    ];

    // 1. Copy Directories
    dirsToCopy.forEach(dir => {
        const src = path.join(packageDir, dir);
        const dest = path.join(targetDir, dir);

        if (fs.existsSync(src)) {
            copyRecursiveSync(src, dest);
            console.log(`Created: ${dir}`);
        }
    });

    // 2. Copy Files
    filesToCopy.forEach(file => {
        const src = path.join(packageDir, file);
        const dest = path.join(targetDir, file);

        if (fs.existsSync(src)) {
            copyFile(src, dest);
            console.log(`Created: ${file}`);
        } else if (file === '.env.example' && fs.existsSync(path.join(packageDir, '.env'))) {
            copyFile(path.join(packageDir, '.env'), dest);
            console.log(`Created: ${file}`);
        }
    });

    // 3. Update package.json scripts
    updatePackageJson(targetDir);

    console.log('\nProject initialized successfully!');
    console.log('Run "npm install" to install dependencies.');
}

function updatePackageJson(targetDir) {
    const pkgPath = path.join(targetDir, 'package.json');

    if (!fs.existsSync(pkgPath)) {
        console.log('Warning: package.json not found. Creating a minimal one...');
        const minimalPkg = {
            name: path.basename(targetDir),
            version: '1.0.0',
            scripts: {
                "dev": "node --watch index.js",
                "test": "jest"
            },
            dependencies: {
                "luak-express": "^2.1.3"
            }
        };
        fs.writeFileSync(pkgPath, JSON.stringify(minimalPkg, null, 2));
        return;
    }

    try {
        const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
        pkg.scripts = pkg.scripts || {};

        // Add scripts if they don't exist
        if (!pkg.scripts.dev) {
            pkg.scripts.dev = "node --watch index.js";
        }

        // Smarter test script detection: if it's the default npm error or missing, replace it
        const defaultNpmTest = 'echo "Error: no test specified" && exit 1';
        if (!pkg.scripts.test || pkg.scripts.test === defaultNpmTest) {
            pkg.scripts.test = "jest";
        }

        fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2));
        console.log('Updated: package.json scripts');
    } catch (e) {
        console.error('Error updating package.json:', e.message);
    }
}

function copyRecursiveSync(src, dest) {
    const exists = fs.existsSync(src);
    const stats = exists && fs.statSync(src);
    const isDirectory = exists && stats.isDirectory();

    if (isDirectory) {
        if (!fs.existsSync(dest)) {
            fs.mkdirSync(dest);
        }

        fs.readdirSync(src).forEach(childItemName => {
            copyRecursiveSync(path.join(src, childItemName), path.join(dest, childItemName));
        });
    } else {
        copyFile(src, dest);
    }
}

/**
 * Copy a file and apply transformation if it's a text file
 */
function copyFile(src, dest) {
    const extension = path.extname(src);
    const basename = path.basename(src);
    const textFiles = ['.js', '.ejs', '.json', '.example', '.md', '.log'];

    // Check if it's a text file or a hidden config file (like .env)
    if (textFiles.includes(extension) || basename.startsWith('.')) {
        let content = fs.readFileSync(src, 'utf8');
        content = transformContent(content);
        fs.writeFileSync(dest, content);
    } else {
        fs.copyFileSync(src, dest);
    }
}

/**
 * Transform template content to use package name instead of relative paths
 */
function transformContent(content) {
    // 1. Replace relative src/index imports with the package name
    // Matches: require('./src/index'), require('../src/index'), etc.
    content = content.replace(/require\(['"](\.\/|\.\.\/)+src\/index(\.js)?['"]\)/g, "require('luak-express')");

    // 2. Replace other relative src imports with package-based src paths
    // Matches: require('./src/Support/helpers') -> require('luak-express/src/Support/helpers')
    content = content.replace(/require\(['"](\.\/|\.\.\/)+src\/(.*?)['"]\)/g, "require('luak-express/src/$2')");

    // 3. Handle JSDoc imports or other text-based references
    content = content.replace(/import\(['"](\.\/|\.\.\/)+src\/(.*?)['"]\)/g, "import('luak-express/src/$2')");

    return content;
}
